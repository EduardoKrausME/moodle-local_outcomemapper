<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/outcomemapper/db" VERSION="2026093000" COMMENT="XMLDB file for local_outcomemapper"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
    <TABLES>
        <TABLE NAME="local_outcomemapper_analysis" COMMENT="Outcome mapper analysis runs">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="running"/>
                <FIELD NAME="objectivecount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="targetcount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="batches" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="inputhash" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT=""/>
                <FIELD NAME="objectivesjson" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="targetsjson" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="warningsjson" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="coursefk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="course_time_idx" UNIQUE="false" FIELDS="courseid,timecreated"/>
                <INDEX NAME="user_idx" UNIQUE="false" FIELDS="userid"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="local_outcomemapper_suggest" COMMENT="AI suggested semantic relations">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="analysisid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="objectivekey" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT=""/>
                <FIELD NAME="objectivetitle" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
                <FIELD NAME="targetkey" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT=""/>
                <FIELD NAME="targettitle" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
                <FIELD NAME="targetroles" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT=""/>
                <FIELD NAME="relation" TYPE="char" LENGTH="12" NOTNULL="true" DEFAULT="none"/>
                <FIELD NAME="confidence" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="evidence" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="explanation" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="status" TYPE="char" LENGTH="12" NOTNULL="true" DEFAULT="suggested"/>
                <FIELD NAME="reviewedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timereviewed" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="analysisfk" TYPE="foreign" FIELDS="analysisid" REFTABLE="local_outcomemapper_analysis"
                     REFFIELDS="id"/>
                <KEY NAME="coursefk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="course_status_idx" UNIQUE="false" FIELDS="courseid,status"/>
                <INDEX NAME="reviewer_idx" UNIQUE="false" FIELDS="reviewedby"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="local_outcomemapper_map" COMMENT="Mappings confirmed by a teacher">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="objectivekey" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT=""/>
                <FIELD NAME="objectivetitle" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
                <FIELD NAME="targetkey" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT=""/>
                <FIELD NAME="targettitle" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
                <FIELD NAME="targetroles" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT=""/>
                <FIELD NAME="relation" TYPE="char" LENGTH="12" NOTNULL="true" DEFAULT="none"/>
                <FIELD NAME="confidence" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="evidence" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="explanation" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="sourceanalysisid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="confirmedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="coursefk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="confirmedby_idx" UNIQUE="false" FIELDS="confirmedby"/>
                <INDEX NAME="lookup_idx" UNIQUE="true" FIELDS="courseid,objectivekey,targetkey"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
